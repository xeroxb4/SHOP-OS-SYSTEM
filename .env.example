# MongoDB connection string (Atlas: Database > Connect > Drivers).
# Replace USERNAME, PASSWORD and HOST. Put the database name (shop-os) between the "/" and the "?".
# Do not keep the < > brackets. Use letters and numbers only in the password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST.mongodb.net/shop-os?retryWrites=true&w=majority

# Secret used to sign login cookies. Required, 32+ random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

NEXT_PUBLIC_APP_NAME=Shop OS System

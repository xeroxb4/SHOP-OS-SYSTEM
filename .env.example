# MongoDB Atlas connection string
# Get free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shop-os?retryWrites=true&w=majority

# JWT secret (generate a long random string)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# App
NEXT_PUBLIC_APP_NAME=Shop OS System
NODE_ENV=development
